rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMeetingHost(meetingData) {
      return isAuthenticated() && request.auth.uid == meetingData.hostId;
    }

    function isMeetingParticipant(meetingId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/meetings/$(meetingId)/participants/$(request.auth.uid));
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Soft deletes handled via backend
    }

    // Meetings collection
    match /meetings/{meetingId} {
      // Anyone with link can view non-private metadata, but private fields are hidden
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isMeetingHost(resource.data);
      allow delete: if isMeetingHost(resource.data);

      // In-meeting Messages
      match /messages/{messageId} {
        allow read: if isMeetingParticipant(meetingId) || isMeetingHost(get(/databases/$(database)/documents/meetings/$(meetingId)).data);
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isOwner(resource.data.senderId) || isMeetingHost(get(/databases/$(database)/documents/meetings/$(meetingId)).data);
      }

      // In-meeting Participants
      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.auth.uid == participantId;
        allow update: if isOwner(participantId) || isMeetingHost(get(/databases/$(database)/documents/meetings/$(meetingId)).data);
        allow delete: if isOwner(participantId) || isMeetingHost(get(/databases/$(database)/documents/meetings/$(meetingId)).data);
      }

      // Waiting Room Join Requests
      match /join_requests/{requestId} {
        allow read, update: if isMeetingHost(get(/databases/$(database)/documents/meetings/$(meetingId)).data);
        allow create: if isAuthenticated();
        allow delete: if isMeetingHost(get(/databases/$(database)/documents/meetings/$(meetingId)).data) || isOwner(resource.data.userId);
      }
    }

    // Abuse Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false; // Admin-only backend
    }
  }
}
